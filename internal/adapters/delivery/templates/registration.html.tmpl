<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="x-apple-disable-message-reformatting">
  <title>{{.Subject}}</title>
</head>
<body style="margin:0;padding:0;background:#f5f7f9;color:#172b4d;font-family:'IBM Plex Sans',Arial,sans-serif;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;mso-hide:all;">{{.Preheader}}&#8199;&#847;&nbsp;&#8199;&#847;&nbsp;&#8199;&#847;&nbsp;&#8199;&#847;&nbsp;&#8199;&#847;&nbsp;</div>
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;background:#f5f7f9;border-collapse:collapse;">
    <tr>
      <td align="center" style="padding:40px 0;">
        <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:600px;border-collapse:collapse;">
          <tr>
            <td class="page-pad" style="padding:0 5.333333%;">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;border-collapse:separate;border-spacing:0;">
                <tr>
                  <td style="padding:0 0 20px;">
                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;">
                      <tr>
                        <td width="28" height="28" style="width:28px;height:28px;padding:0;vertical-align:middle;"><img src="cid:{{.LogoContentID}}" width="28" height="28" alt="Ровный ход" style="display:block;width:28px;height:28px;border:0;"></td>
                        <td style="padding:0 0 0 8px;font-size:16px;line-height:24px;font-weight:600;color:#172b4d;vertical-align:middle;">Ровный ход</td>
                      </tr>
                    </table>
                  </td>
                </tr>
                <tr>
                  <td class="card-pad" style="padding:6%;background:#ffffff;border:1px solid #d3dbe3;border-radius:12px;">
                    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;border-collapse:collapse;">
                      <tr><td style="padding:0 0 16px;font-size:24px;line-height:32px;font-weight:600;color:#172b4d;word-break:break-word;">Подтвердите регистрацию</td></tr>
                      <tr><td style="padding:0 0 16px;font-size:16px;line-height:24px;color:#172b4d;word-break:break-word;">Введите этот код на странице регистрации оператора:</td></tr>
                      <tr>
                        <td style="padding:20px 16px;background:#eaf7ef;border-radius:8px;text-align:center;">
                          <div class="otp-code" style="padding:0 0 6px;font-family:'IBM Plex Mono',Menlo,Consolas,monospace;font-size:36px;line-height:42px;font-weight:500;letter-spacing:10px;color:#172b4d;white-space:nowrap;">{{.GroupedCode}}</div>
                          <div style="font-size:14px;line-height:20px;color:#526579;word-break:break-word;">Срок действия кода истекает: {{.ExpiresAt}} МСК.</div>
                        </td>
                      </tr>
                      <tr><td style="padding:16px 0;font-size:14px;line-height:20px;color:#526579;word-break:break-word;">Запрос: {{.CreatedAt}} МСК.</td></tr>
                      <tr><td style="padding:16px 0 0;border-top:1px solid #d3dbe3;font-size:16px;line-height:24px;color:#172b4d;word-break:break-word;">Если вы не запрашивали регистрацию, просто проигнорируйте это письмо. Никому не сообщайте код.</td></tr>
                      <tr><td style="padding:8px 0 0;font-size:14px;line-height:20px;color:#526579;word-break:break-word;">Сотрудники «Ровного хода» никогда не попросят код.</td></tr>
                    </table>
                  </td>
                </tr>
                <tr><td style="padding:20px 0 0;font-size:14px;line-height:20px;color:#526579;word-break:break-word;">Письмо отправлено автоматически, отвечать на него не нужно.</td></tr>
                <tr><td style="padding:6px 0 0;font-size:14px;line-height:20px;color:#526579;word-break:break-word;">«Ровный ход» · {{.OperatorName}} · {{.OperatorAddress}}</td></tr>
                {{if .PrivacyURL}}<tr><td style="padding:6px 0 0;font-size:14px;line-height:20px;word-break:break-all;"><a href="{{.PrivacyURL}}" style="color:#006b63;text-decoration:underline;word-break:break-all;">Политика конфиденциальности</a></td></tr>{{end}}
              </table>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
